# Copie para .env e ajuste.

# Porta do painel web + API
PORT=3000
# Porta TCP que os rastreadores usam (GT06, H02 e TK103 com detecção automática)
TCP_PORT=5023
# Porta pública a informar aos rastreadores quando há proxy TCP na frente (Railway etc.)
PUBLIC_TCP_PORT=
# Portas dedicadas opcionais (0 = desligado)
TCP_PORT_GT06=0
TCP_PORT_H02=0
TCP_PORT_TK103=0

# Onde o banco SQLite e o segredo JWT ficam
DATA_DIR=./data

# Segredo para assinar os tokens de login (gere com: openssl rand -hex 48)
JWT_SECRET=
JWT_EXPIRES_HOURS=168

# Usuário administrador criado na primeira execução
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@rastrocar.local
ADMIN_PASSWORD=admin123

# IP fixo ou domínio público que os rastreadores devem usar (também editável no painel)
PUBLIC_HOST=

# Aceitar rastreadores desconhecidos (criados como "pendentes" para vincular ao veículo)
AUTO_REGISTER_DEVICES=true

# debug | info | warn | error
LOG_LEVEL=info
TZ=America/Sao_Paulo
