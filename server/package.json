{
  "name": "@rastrocar/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings=ExperimentalWarning dist/index.js",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test \"src/**/*.test.ts\"",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
